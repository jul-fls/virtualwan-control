VWAN_ADMIN_USER=admin
VWAN_IMAGE=ghcr.io/jul-fls/virtualwan-control:latest
VWAN_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
VWAN_PUBLIC_URL=http://localhost:8080
VWAN_BIND_ADDRESS=127.0.0.1
VWAN_DEMO=false
VWAN_ENABLE_PROVISIONING=false
VWAN_ENABLE_PURCHASES=false
# Public HTTPS URL belongs to your Cloudflare Tunnel / Nginx Proxy Manager.
# The application always serves HTTP on container port 8080.
# Optional exact IP of the direct proxy: trust one X-Forwarded-For hop only.
# VWAN_TRUSTED_PROXY=172.20.0.2
# Optional declarative inventories. Each object needs a stable "id"; JSON may
# span multiple lines inside single quotes in this .env file (Compose syntax).
VWAN_PROFILES_JSON=[]
VWAN_MODELS_JSON=[]
# Provider and infrastructure credentials: names must match *_env in profiles.
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# CLOUDFLARE_API_TOKEN=
# PFSENSE_PASSWORD=
# PVE_SSH_PASSWORD=
# ROUTER_SSH_PASSWORD=
# Optional approval notification; always links to an authenticated POST confirmation.
# VWAN_APPROVAL_EMAIL=operator@example.net
# VWAN_SMTP_HOST=smtp.example.net
# VWAN_SMTP_PORT=587
# VWAN_SMTP_FROM=virtualwan@example.net
# VWAN_SMTP_USER=virtualwan@example.net
# VWAN_SMTP_PASSWORD=REPLACE
