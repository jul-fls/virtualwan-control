VWAN_ADMIN_USER=admin
VWAN_IMAGE=ghcr.io/jul-fls/virtualwan-control:latest
VWAN_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
VWAN_PUBLIC_URL=http://localhost:8080
VWAN_BIND_ADDRESS=127.0.0.1
VWAN_DEMO=false
VWAN_ENABLE_PROVISIONING=false
VWAN_ENABLE_PURCHASES=false
# Public HTTPS URL belongs to your Cloudflare Tunnel / Nginx Proxy Manager.
# The application always serves HTTP on container port 8080.
# Optional exact IP of the direct proxy: trust one X-Forwarded-For hop only.
# VWAN_TRUSTED_PROXY=172.20.0.2
# Profiles and models are stored in /data/control.sqlite3 and edited in the UI.
# The former *_JSON variables are only supported for one-time legacy imports.
# Optional: bootstrap ONE router with scalar variables, then set this to false.
VWAN_ROUTER_BOOTSTRAP=false
VWAN_PROFILE_ID=router-1
VWAN_MODEL_BOOTSTRAP=false
# Additional routers and models are created through the administration UI.
# Provider and infrastructure credentials: names must match *_env in profiles.
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# CLOUDFLARE_API_TOKEN=
# PFSENSE_PASSWORD=
# PVE_SSH_PASSWORD=
# ROUTER_SSH_PASSWORD=
# Optional approval notification; always links to an authenticated POST confirmation.
# VWAN_APPROVAL_EMAIL=operator@example.net
# VWAN_SMTP_HOST=smtp.example.net
# VWAN_SMTP_PORT=587
# VWAN_SMTP_FROM=virtualwan@example.net
# VWAN_SMTP_USER=virtualwan@example.net
# VWAN_SMTP_PASSWORD=REPLACE

# Optional routed IPv6. First configure the /64 upstream and on pfSense.
# Replace documentation addresses before enabling; see docs/IPV6.md.
# Uses VWAN_PROFILE_ID above when multiple profiles exist.
# VWAN_IPV6_ENABLED=true
# VWAN_IPV6_NETWORK=2001:db8:1234:1::/64
# VWAN_IPV6_GATEWAY_ADDRESS=2001:db8:1234:1::1
# VWAN_IPV6_GATEWAY_LINK_LOCAL=fe80::1
# VWAN_IPV6_PROTECTED_NETWORKS=2001:db8:1234::/60
# VWAN_IPV6_WAN_INTERFACE=wan
# VWAN_IPV6_PUBLIC_ALIAS=VWAN_CLIENTS_V6
# VWAN_IPV6_PROTECTED_ALIAS=VWAN_PROTECTED_V6

# Optional rescue ISO already available on every eligible Proxmox node.
# VWAN_RESCUE_ISO=iso:iso/virtualwan-rescue-debian13-amd64-v3.iso
# Clients use /client; WebSocket forwarding must be enabled on the reverse proxy.

# Optional scalar router bootstrap fields (defaults shown).
# VWAN_ROUTER_NAME=Routeur principal
# VWAN_ROUTER_PROVIDER=ovh
# VWAN_ROUTER_CAPACITY=16
# VWAN_ROUTER_READY=false
# VWAN_ROUTER_DOMAIN=hosting.example.net
# VWAN_ROUTER_HOSTNAME_PATTERN=vps-{ipv4_compact}.{domain}
# VWAN_ROUTER_WG_WAN_INTERFACE=ens3
# VWAN_ROUTER_WG_LISTEN_PORT=51820
# VWAN_ROUTER_WG_MTU=1420
# VWAN_ROUTER_WG_TUNNEL_ADDRESS=10.254.250.1/30
# VWAN_ROUTER_WG_PEER_ADDRESS=10.254.250.2
# VWAN_ROUTER_WG_PEER_PUBLIC_KEY=
# VWAN_ROUTER_BACKUP_KEY_ENV=VWAN_BACKUP_KEY
# VWAN_CLOUDFLARE_ZONE_ID=REPLACE_ZONE_ID
# VWAN_CLOUDFLARE_TOKEN_ENV=CLOUDFLARE_API_TOKEN
# VWAN_CLOUDFLARE_TTL=300
# VWAN_OVH_ENDPOINT=https://eu.api.ovh.com/1.0
# VWAN_OVH_SUBSIDIARY=FR
# VWAN_OVH_EXPECTED_SERVICE=
# VWAN_OVH_IP_BLOCK=
# VWAN_OVH_APPLICATION_KEY_ENV=OVH_APPLICATION_KEY
# VWAN_OVH_APPLICATION_SECRET_ENV=OVH_APPLICATION_SECRET
# VWAN_OVH_CONSUMER_KEY_ENV=OVH_CONSUMER_KEY
# VWAN_ROUTER_HOST=192.0.2.10
# VWAN_ROUTER_PORT=22
# VWAN_ROUTER_USERNAME=debian
# VWAN_ROUTER_PASSWORD_ENV=ROUTER_SSH_PASSWORD
# VWAN_ROUTER_PRIVATE_KEY=
# VWAN_ROUTER_KEY_PASSPHRASE_ENV=
# VWAN_ROUTER_KNOWN_HOSTS=/data/ssh-known-hosts
# VWAN_ROUTER_SUDO=true
# VWAN_ROUTER_SUDO_PASSWORD_ENV=ROUTER_SSH_PASSWORD
# VWAN_ROUTER_PRIMARY_IP=192.0.2.10
# VWAN_ROUTER_CONFIG_PATH=/etc/virtualwan/virtualwan.json
# VWAN_PVE_HOST=192.168.1.10
# VWAN_PVE_PORT=22
# VWAN_PVE_USERNAME=root
# VWAN_PVE_PASSWORD_ENV=PVE_SSH_PASSWORD
# VWAN_PVE_PRIVATE_KEY=
# VWAN_PVE_KEY_PASSPHRASE_ENV=
# VWAN_PVE_KNOWN_HOSTS=/data/ssh-known-hosts
# VWAN_PVE_SUDO=false
# VWAN_PVE_NODE=pve-node
# VWAN_PVE_TEMPLATE=9001
# VWAN_PVE_VMID=
# VWAN_PVE_VMID_START=120
# VWAN_PVE_BRIDGE=vmbr12
# VWAN_PVE_DISK_STORAGE=local-lvm
# VWAN_PVE_SNIPPET_STORAGE=snippets
# VWAN_PVE_SNIPPET_DIRECTORY=/mnt/pve/snippets/snippets
# VWAN_PVE_CORES=2
# VWAN_PVE_MEMORY_MB=2048
# VWAN_PVE_DISK_GB=32
# VWAN_GUEST_USERNAME=debian
# VWAN_GUEST_SSH_AUTH=key
# VWAN_GUEST_SSH_PUBLIC_KEY_FILE=
# VWAN_GUEST_PASSWORD_ENV=GUEST_SSH_PASSWORD
# VWAN_GUEST_INTERFACE=ens18
# VWAN_GUEST_GATEWAY=10.254.251.1
# VWAN_GUEST_MTU=1420
# VWAN_GUEST_DNS=1.1.1.1,9.9.9.9
# VWAN_PFSENSE_URL=https://firewall.example.net
# VWAN_PFSENSE_USERNAME=admin
# VWAN_PFSENSE_PASSWORD_ENV=PFSENSE_PASSWORD
# VWAN_PFSENSE_CA_BUNDLE=
# VWAN_PFSENSE_CERTIFICATE_SHA256=
# VWAN_PFSENSE_CONNECT_IP=
# VWAN_PFSENSE_PUBLIC_INTERFACE=opt_public
# VWAN_PFSENSE_WIREGUARD_INTERFACE=opt_wireguard
# VWAN_PFSENSE_PUBLIC_ALIAS=VWAN_PUBLIC_IPS
# VWAN_PFSENSE_WIREGUARD_GATEWAY=WG_PUBLIC_GW
# VWAN_PFSENSE_NEXT_HOP=
# VWAN_PFSENSE_NEXT_HOP_NETWORK=10.254.251.0/24
# VWAN_ROUTER_START_VM=true
# VWAN_ROUTER_REBOOT_TEST=true
# VWAN_ROUTER_REQUIRE_CLIENT_ISOLATION=true

# VWAN_MODEL_ID=standard
# VWAN_MODEL_NAME=Standard
# VWAN_MODEL_RANGE=Standard
# VWAN_MODEL_CORES=2
# VWAN_MODEL_MEMORY_MB=2048
# VWAN_MODEL_DISK_GB=32
# VWAN_MODEL_TEMPLATE=9001
